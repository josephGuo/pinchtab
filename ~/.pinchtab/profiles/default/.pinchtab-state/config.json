  "browser": {
    "version": "",
    "binary": "",
    "remoteDebuggingPort": 9889,
    "extraFlags": "",
    "extensionPaths": []
  },
  "browsers": {
    "default": "chrome",
    "available": [
      "chrome"
    ]
  },
  "instanceDefaults": {
    "mode": "headed",
    "noRestore": false,
    "timezone": "Asia/Shanghai",
    "blockImages": false,
    "blockMedia": false,
    "blockAds": false,
    "maxTabs": 30,
    "maxParallelTabs": 0,
    "userAgent": "",
